# 本地开发环境变量示例
# 复制此文件为 .dev.vars 并填入实际值
# .dev.vars 已在 .gitignore 中，不会被提交到 git

EDITORS=editor1@example.com,editor2@example.com
ADMINS=admin@example.com

# 可选：Cloudflare Access audience tag
# CLOUDFLARE_ACCESS_AUD=your-aud-tag


# Account email Worker (wrangler.email.toml), server-only secrets.
# RESEND_API_KEY=your-dedicated-sending-only-key
# OTP_SECRET=generate-a-random-secret-of-at-least-32-bytes
# FIREBASE_SERVICE_ACCOUNT={"project_id":"schedule-59d28","client_email":"...","private_key":"..."}
