# Worker hosting /api/ideas/*
VITE_IDEAS_API_URL=https://schedule-admin-api.danielzhang089.workers.dev

# Link target on each idea's detail page
VITE_GITHUB_REPO_URL=https://github.com/daniezl/Hilltoppers

# Same Firebase project as the extension. Using the same project is what makes
# a vote from the popup and a vote from the site resolve to one account.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
